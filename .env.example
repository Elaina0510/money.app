# Money App 环境变量配置
# 复制此文件为 .env 并修改对应的值

# ============================================================
# 数据库 (SQLite)
# ============================================================
# Docker 部署时使用容器内路径，本地开发时使用本地路径
DATABASE_URL=sqlite+aiosqlite:///data/db/money.db

# ============================================================
# 认证
# ============================================================
# 生产环境务必修改为随机字符串！可用: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=money-app-change-this-secret-key-in-production

# Token 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# 文件上传
# ============================================================
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=10485760
MAX_TOTAL_UPLOAD_SIZE=524288000
